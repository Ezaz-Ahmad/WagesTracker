# Leave unset for local dev — Vite's dev server proxies /api to the backend (see vite.config.ts).
# In production, set this to the deployed backend's origin (no trailing slash), e.g.:
# VITE_API_URL=https://wage-tracker-api.onrender.com
VITE_API_URL=

# Build target. Keep "web" for Vercel/local development. Future signed native
# builds set ios/android and are rejected unless VITE_API_URL is the pinned
# HTTPS production API. Never set a live-reload URL in a production build.
VITE_APP_TARGET=web
# VITE_CAPACITOR_SERVER_URL=http://192.168.1.2:5173

# Optional browser-only viewport diagnostics. Never enable this for a native
# release; the native production guard rejects it.
# VITE_VIEWPORT_DEBUG=true

# APPLE_TEAM_ID is intentionally not listed as a VITE_ variable. The
# post-build association-file generator reads it from the Vercel/build-process
# environment so it is never bundled as application configuration.
