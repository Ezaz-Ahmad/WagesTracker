PORT=4000
NODE_ENV=development
# Generate a strong secret for production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
# Local SQLite file, used only when TURSO_DATABASE_URL is unset (see below).
DB_PATH=./data/wage-tracker.sqlite
# Leave both unset for local dev — the app falls back to the local SQLite file above.
# Set both in production to a hosted libSQL/Turso database so data survives redeploys
# (most PaaS filesystems, Render's free plan included, wipe local files on every deploy).
# Get these from `turso db show <db-name> --url` and `turso db tokens create <db-name>`.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Comma-separated list of browser origins allowed to call this API.
# Leave blank for local development so development mode accepts the localhost frontend.
# Production (configured in render.yaml; never use a wildcard for authenticated requests):
# ALLOWED_ORIGINS=https://wages-tracker-frontend.vercel.app,capacitor://localhost
ALLOWED_ORIGINS=
# Password for the admin panel (frontend path /admin) — a single shared secret, unrelated
# to any user account. Leave unset to disable the admin panel entirely. Pick something
# strong; it's the only thing standing between the public internet and every user's data.
ADMIN_PASSWORD=
# Optional Argon2id password-hashing configuration
# These defaults follow the current application security settings.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Transactional password-recovery email. In production all three values are
# required; without them the normal API remains available but reset requests
# return 503. RESEND_API_KEY is a server secret and must never be exposed as a
# VITE_ variable or added to the iOS project.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Wage Tracker <no-reply@your-verified-domain.com>
# MAIL_REPLY_TO=support@your-domain.com
# Public HTTPS origin of the frontend. Reset links are built from this value.
# APP_BASE_URL=https://wages-tracker-frontend.vercel.app

# Recovery rate-limit overrides. The built-in defaults are normally suitable;
# these primarily exist for isolated automated tests.
# RATE_LIMIT_FORGOT_PASSWORD_IP=5
# RATE_LIMIT_FORGOT_PASSWORD_EMAIL=3
# RATE_LIMIT_RESET_PASSWORD=15
