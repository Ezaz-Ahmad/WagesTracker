PORT=4000
NODE_ENV=development
# Generate a strong secret for production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
DB_PATH=./data/wage-tracker.sqlite
# Comma-separated list of browser origins allowed to call this API (required in production), e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app
ALLOWED_ORIGINS=
