{
  "name": "wage-tracker",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "verify:libsql": "node frontend/scripts/verify-libsql-platform.mjs",
    "verify:capacitor": "node frontend/scripts/verify-capacitor-alignment.mjs",
    "verify:capacitor:bundle": "node frontend/scripts/verify-capacitor-alignment.mjs --bundle frontend/dist --bundle ios/App/App/public",
    "verify:ios-plugin-registration": "node frontend/scripts/verify-ios-plugin-registration.mjs",
    "ios:build:web": "npm run ios:build:web -w frontend",
    "ios:copy:web": "npm run ios:copy:web -w frontend",
    "ios:sync": "npm run ios:sync -w frontend",
    "ios:resolve:native": "npm run ios:resolve:native -w frontend",
    "ios:build:simulator": "npm run ios:build:simulator -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "jsdom": "^29.1.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "0.5.29",
    "lightningcss-darwin-arm64": "1.33.0"
  }
}
